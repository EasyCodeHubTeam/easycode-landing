# Токен бота от @BotFather. Никогда не коммитьте настоящий .env!
BOT_TOKEN=
# ID чата, куда приходят заявки (личка, группа или канал)
CHAT_ID=
# Необязательно: секретный ключ Cloudflare Turnstile
TURNSTILE_SECRET=
# Необязательно: домены сайта, если он не на Vercel (через запятую)
# ALLOWED_ORIGINS=https://easycodehubteam.github.io
ALLOWED_ORIGINS=
